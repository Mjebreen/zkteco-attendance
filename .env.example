# ===== ZKTeco device (collector only; leave ZK_IP empty on a cloud-hosted web instance) =====
# Device menu: Comm > Ethernet > IP Address
ZK_IP=192.0.2.10
ZK_PORT=4370
# Comm key (Comm > Comm Key). 0 = no key (factory default)
ZK_PASSWORD=0
ZK_TIMEOUT=10
# Some firmwares only answer over UDP / drop ICMP; flip these if connect() times out.
ZK_FORCE_UDP=false
ZK_OMIT_PING=false

# ===== Branding =====
COMPANY_NAME=Your Company

# ===== Shift day =====
# Hour (0-23) the workday starts. Shift day D = [D DAY_START_HOUR:00, D+1 DAY_START_HOUR:00).
# 0 = plain calendar days.
DAY_START_HOUR=7

# ===== Dashboard extras =====
# Daily hours target shown as a progress bar (live on the current day).
TARGET_HOURS=6
# Check-in badges (HH:MM, 24h). First punch at/after LATE_AFTER_TIME = "Late"; before EARLY_BEFORE_TIME = "Early".
# LATE_EARLY_TURN_TIME is where the late window ends and the early window begins (wraps past midnight):
#   late = 18:30 -> 01:00      early = 01:00 -> 13:00      normal = 13:00 -> 18:30
# Set a value to empty to disable that badge.
LATE_AFTER_TIME=18:30
EARLY_BEFORE_TIME=13:00
LATE_EARLY_TURN_TIME=01:00
# Default UI language: en | ar (users can switch; the choice is remembered per browser).
DEFAULT_LANG=en
# First column of the employee calendar: monday | sunday | saturday
WEEK_START=monday

# ===== Timezone =====
# MUST equal the device's local timezone (IANA name, e.g. Europe/Berlin, Asia/Dubai, America/New_York).
# Device timestamps are stored as naive local time in that zone.
TZ=UTC

# ===== API =====
# Shared secret for /report, /summary, /api/* (header X-API-Key or ?api_key=). 32+ random chars:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-32-random-chars

# ===== Database =====
# SQLite on the docker volume (single-box) ...
DATABASE_URL=sqlite:////data/attendance.db
# ... or Postgres (split deploy / `--profile postgres`):
# DATABASE_URL=postgresql://attendance:change-me@postgres:5432/attendance
# POSTGRES_DB=attendance
# POSTGRES_USER=attendance
# POSTGRES_PASSWORD=change-me

# ===== Collector =====
POLL_INTERVAL_MINUTES=5
# db   = write straight into DATABASE_URL (single box)
# http = POST snapshots to INGEST_URL/api/ingest with API_KEY (collector on LAN, web in the cloud)
COLLECTOR_TARGET=db
INGEST_URL=

# ===== Web =====
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
# HTTP Basic Auth for / and /print (internet-facing). The dashboard refuses to start without a password.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# Generated PDFs are written here before being served.
OUTPUT_DIR=/data/reports

# ===== Misc =====
# json (default) or text
LOG_FORMAT=json
LOG_LEVEL=INFO
# Run Alembic migrations automatically on start (web + collector). Set false if you manage schema yourself.
AUTO_MIGRATE=true
